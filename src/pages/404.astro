---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" noIndex={true}>
  <section class="not-found">
    <div class="container" style="text-align: center;">
      <span class="text-label">Error 404</span>
      <h1>Página no encontrada</h1>
      <p>La página que buscás no existe o fue movida.</p>
      <div style="margin-top: var(--space-xl); display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn btn--primary">Volver al inicio</a>
        <a href="/perfumes" class="btn btn--outline">Explorar fragancias</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4xl) 0;
  }

  .not-found h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    margin: var(--space-md) 0 var(--space-lg);
  }

  .not-found p {
    color: var(--color-carbon-light, #3A3A39);
    font-size: var(--font-size-lg);
    max-width: 400px;
    margin: 0 auto;
  }
</style>
