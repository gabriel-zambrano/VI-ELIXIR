  }

  .finder-empty {
    padding: var(--space-2xl) var(--space-md);
    max-width: 520px;
    margin-inline: auto;
    text-align: center;
  }

  .finder-empty h3 {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    font-weight: 400;
