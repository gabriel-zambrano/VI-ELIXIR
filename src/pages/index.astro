---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products, categories, giftSets, formatPrice } from '../data/products';
---

<BaseLayout title="Inicio">
  <!-- 1. Hero Section -->
  <div class="hero-wrapper">
    <div class="hero-ambient" aria-hidden="true">
      <div class="hero-ambient-canvas"></div>
      <div class="hero-ambient-tint"></div>
    </div>
    <section class="hero">
      <div class="hero-content">
        <span class="text-label">Perfumería Árabe Contemporánea</span>
        <h1 class="hero-title">Dejá tu esencia.</h1>
        <p class="hero-subtitle">Fragancias para explorar nuevas facetas de tu identidad.</p>
        <div class="hero-actions">
          <a href="/perfumes" class="btn btn--primary">Explorar fragancias</a>
          <a href="/la-marca" class="btn btn--outline">Descubrir VI-ELIXIR</a>
        </div>
      </div>
      <div class="hero-image">
        <div class="hero-video-card">
          <div class="hero-video-wrapper">
            <video
              id="hero-ambient-video"
              src="/videos/perfumevideo.mp4"
              poster="/videos/perfumevideo-poster.webp"
              autoplay
              muted
              loop
              playsinline
              preload="auto"
              class="hero-video-element"
              aria-label="Campaña audiovisual VI-ELIXIR: frasco de autor y experiencia sensorial"
            >
              Tu navegador no soporta reproducción de video HTML5.
            </video>
          </div>
          <div class="hero-video-controls" role="group" aria-label="Seleccionar versión del video">
            <button
              type="button"
              class="hero-video-btn is-active"
              data-video-src="/videos/perfumevideo.mp4"
              data-poster-src="/videos/perfumevideo-poster.webp"
              aria-pressed="true"
            >
              <span class="btn-indicator"></span>
              Frasco de Autor
            </button>
            <button
              type="button"
              class="hero-video-btn"
              data-video-src="/videos/videoperfume01.mp4"
              data-poster-src="/videos/videoperfume01-poster.webp"
              aria-pressed="false"
            >
              <span class="btn-indicator"></span>
              Noche en el Desierto
            </button>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- 2. Featured Products Section -->
  <section class="section-padding">
    <div class="container">
      <div class="section-header reveal">
        <span class="text-label">Colección</span>
        <h2>El arte de elegir una esencia.</h2>
        <p>Explorá fragancias con distintas personalidades, familias olfativas y formas de expresión.</p>
      </div>
      <div class="products-grid reveal">
        {products.map(product => (
          <a href={`/perfumes/${product.slug}`} class="product-card">
            <div class="product-card-image">
              <img src={product.image} alt={product.name} width="400" height="530" loading="lazy" />
            </div>
            <div class="product-card-info">
              <span class="product-card-family">{product.categoriaPrincipal} · {product.sku}</span>
              <h3 class="product-card-name">{product.name}</h3>
              <p class="product-card-desc">{product.shortDescription}</p>
              <span class="product-card-price">{formatPrice(product.price)}</span>
            </div>
          </a>
        ))}
      </div>
      <div class="section-cta reveal">
        <a href="/perfumes" class="btn btn--outline">Ver todo el catálogo</a>
      </div>
    </div>
  </section>

  <!-- 3. Brand Story Section -->
  <section class="brand-story section-padding" style="background: var(--color-carbon); color: var(--color-ivory);">
    <div class="container">
      <div class="brand-story-grid reveal">
        <div class="brand-story-content">
          <span class="text-label" style="color: var(--color-stone);">Nuestra Esencia</span>
          <h2 style="color: var(--color-ivory);">Una esencia. Muchas formas de expresarte.</h2>
          <p>En VI-ELIXIR entendemos la perfumería como una forma de expresión personal. Exploramos el universo de las fragancias árabes desde una mirada contemporánea, donde cada aroma invita a descubrir nuevas sensaciones, preferencias y formas de identidad.</p>
          <a href="/la-marca" class="btn btn--outline" style="border-color: var(--color-ivory); color: var(--color-ivory);">Conocer la marca</a>
        </div>
        <div class="brand-story-image">
          <img src="/images/editorial/marca-filosofia.webp" alt="Frasco solitario de perfume sobre piedra travertino y lino natural — Filosofía VI-ELIXIR" width="1200" height="800" decoding="async" loading="lazy" style="border-radius: var(--border-radius-sm); object-fit: cover;" />
        </div>
      </div>
    </div>
  </section>

  <!-- 3.5 Nuestras Esencias / Acordes Section -->
  <section class="sensory-accords section-padding bg-ivory text-center">
    <div class="container container--narrow">
      <div class="section-header reveal">
        <span class="text-label" style="color: var(--color-burgundy);">Materias Primas</span>
        <h2>Aromas que cuentan historias</h2>
        <p>Acordes nobles seleccionados por su pureza, calidez y permanencia sobre la piel.</p>
      </div>
      <div class="sensory-infographic-wrapper reveal">
        <img
          src="/images/editorial/esencias-arcos.jpg"
          alt="Nuestras esencias: Vainilla, Naranja, Flores, Madera y Café — VI-ELIXIR"
          width="1024"
          height="682"
          class="sensory-infographic-img"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- 4. Discovery / Fragrance Finder Section -->
  <section class="discovery section-padding">
    <div class="container">
      <div class="section-header reveal">
        <span class="text-label">Descubrimiento</span>
        <h2>Encontrá tu próxima esencia.</h2>
        <p>Respondé estas preguntas para descubrir qué fragancias conectan con tu estilo.</p>
      </div>
      <div class="finder reveal" id="descubrimiento">
        <!-- Rendered by JS, but provide a noscript fallback -->
        <div class="finder-steps" data-finder>
          <!-- Step 1 -->
          <div class="finder-step" data-step="1">
            <span class="finder-step-badge">Paso 1 de 3</span>
            <h3>¿Qué familias olfativas te atraen?</h3>
            <div class="finder-options">
              <button type="button" class="finder-option" data-family="amaderadas">Amaderadas</button>
              <button type="button" class="finder-option" data-family="ambar-especiadas">Ámbar y especiadas</button>
              <button type="button" class="finder-option" data-family="florales">Florales</button>
              <button type="button" class="finder-option" data-family="almizcladas">Almizcladas</button>
              <button type="button" class="finder-option" data-family="frescas">Frescas</button>
            </div>
          </div>
          <!-- Step 2 -->
          <div class="finder-step" data-step="2" style="display:none;">
            <span class="finder-step-badge">Paso 2 de 3</span>
            <h3>¿Qué intensidad preferís?</h3>
            <div class="finder-options">
              <button type="button" class="finder-option" data-intensity="Suave">Sutil y cercana a la piel</button>
              <button type="button" class="finder-option" data-intensity="Moderada">Moderada y versátil</button>
              <button type="button" class="finder-option" data-intensity="Intensa">Intensa y envolvente</button>
            </div>
            <div class="finder-step-nav">
              <button type="button" class="finder-back-btn" data-finder-back="1">← Volver al paso anterior</button>
            </div>
          </div>
          <!-- Step 3 -->
          <div class="finder-step" data-step="3" style="display:none;">
            <span class="finder-step-badge">Paso 3 de 3</span>
            <h3>¿Para qué ocasión?</h3>
            <div class="finder-options">
              <button type="button" class="finder-option" data-occasion="dia">Día y uso cotidiano</button>
              <button type="button" class="finder-option" data-occasion="noche">Noche y eventos</button>
              <button type="button" class="finder-option" data-occasion="todas">Todas las ocasiones</button>
            </div>
            <div class="finder-step-nav">
              <button type="button" class="finder-back-btn" data-finder-back="2">← Volver al paso anterior</button>
            </div>
          </div>
          <!-- Results -->
          <div class="finder-results" data-finder-results style="display:none;"></div>
        </div>
        <noscript>
          <p>Para usar el selector de fragancias, necesitás tener JavaScript habilitado. También podés <a href="/perfumes">explorar el catálogo completo</a>.</p>
        </noscript>
      </div>
    </div>
  </section>

  <!-- 5. Gift Sets Section -->
  <section class="sets section-padding" style="background: var(--color-ivory-dark, #E8E2D8);">
    <div class="container">
      <div class="section-header reveal">
        <span class="text-label">Sets y Regalos</span>
        <h2>Regalá una experiencia.</h2>
        <p>Descubrí nuestras propuestas de regalo y sets de descubrimiento.</p>
      </div>
      <div class="sets-grid reveal">
        {giftSets.map(set => (
          <div class="set-card">
            <div class="set-card-content">
              <h3>{set.name}</h3>
              <p>{set.description}</p>
              <p class="set-card-presentation">{set.presentation}</p>
              <div class="set-card-pricing">
                <span class="set-card-price">{formatPrice(set.price)}</span>
                <span class="set-card-savings">Ahorrás {formatPrice(set.savings)}</span>
              </div>
              <a href="/contacto" class="btn btn--outline">Consultar disponibilidad</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Journal Teaser -->
  <section class="section-padding">
    <div class="container">
      <div class="section-header reveal">
        <span class="text-label">Journal</span>
        <h2>Explorá el universo olfativo.</h2>
      </div>
      <div class="journal-teaser reveal">
        <a href="/journal/como-elegir-perfume-arabe" class="journal-teaser-card">
          <img src="/images/editorial/journal-guia-eleccion.webp" alt="Pirámide olfativa y materias primas sobre piedra travertino — Guía VI-ELIXIR" width="1200" height="750" decoding="async" loading="lazy" />
          <div class="journal-teaser-content">
            <span class="text-label">Guías</span>
            <h3>Cómo elegir un perfume árabe: familias olfativas, notas y consejos</h3>
            <p style="font-size: var(--font-size-sm); color: var(--color-carbon-light); margin-block: var(--space-xs) var(--space-sm); line-height: var(--line-height-normal);">
              Una guía completa para entender las familias olfativas de la perfumería oriental, las notas de salida, corazón y fondo, y encontrar la fragancia que mejor exprese tu personalidad.
            </p>
            <span class="journal-read-more">Leer artículo →</span>
          </div>
        </a>
      </div>
      <div class="text-center reveal reveal-delay-2" style="margin-top: var(--space-xl);">
        <a href="/journal" class="btn btn--outline">Ver todos los artículos del Journal &rarr;</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==========================================================================
     HERO SECTION & AMBIENT BACKDROP
     ========================================================================== */
  .hero-wrapper {
    position: relative;
    width: 100%;
    min-height: 90vh;
    min-height: max(90vh, 580px);
    background-color: var(--color-ivory);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-ambient {
    position: absolute;
    inset: -30px;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .hero-ambient-canvas {
    position: absolute;
    inset: 0;
    background-image: url('/images/editorial/desert-ambient-bg.webp');
    background-size: cover;
    background-position: center 30%;
    filter: blur(6px) saturate(1.2);
    opacity: 0.85;
    transform: scale(1.05);
    animation: ambientFloat 24s ease-in-out infinite alternate;
    will-change: transform;
  }

  @keyframes ambientFloat {
    0% {
      transform: scale(1.04) translate3d(0, 0, 0);
    }
    50% {
      transform: scale(1.08) translate3d(-1%, -1%, 0);
    }
    100% {
      transform: scale(1.05) translate3d(1%, 0.8%, 0);
    }
  }

  .hero-ambient-tint {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(242, 238, 230, 0.9) 0%, rgba(242, 238, 230, 0.65) 42%, rgba(242, 238, 230, 0.15) 75%, rgba(242, 238, 230, 0.35) 100%),
      linear-gradient(to bottom, transparent 65%, rgba(242, 238, 230, 0.85) 90%, var(--color-ivory) 100%);
  }

  @media (max-width: 1023px) {
    .hero-ambient-tint {
      background:
        radial-gradient(circle at center, rgba(242, 238, 230, 0.85) 0%, rgba(242, 238, 230, 0.6) 65%, rgba(242, 238, 230, 0.95) 100%),
        linear-gradient(to bottom, transparent 60%, var(--color-ivory) 100%);
    }
  }

  .hero {
    position: relative;
    z-index: 1;
    width: 100%;
    background-color: transparent;
    display: flex;
    flex-direction: column-reverse;
    justify-content: center;
    padding: var(--space-2xl) var(--space-md) var(--space-3xl);
  }

  .hero-content {
    max-width: 580px;
    margin-inline: auto;
    text-align: center;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 300;
    line-height: var(--line-height-tight, 1.1);
    letter-spacing: var(--letter-spacing-tight, -0.02em);
    color: var(--color-carbon);
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    font-weight: 300;
    line-height: var(--line-height-normal, 1.6);
    color: var(--color-carbon-light);
    margin-bottom: var(--space-2xl);
    max-width: 480px;
    margin-inline: auto;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }

  .hero-image {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-bottom: var(--space-xl);
  }

  .hero-video-card {
    width: 100%;
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .hero-video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    background: var(--color-black);
    box-shadow: 0 16px 36px rgba(32, 32, 31, 0.16);
    border: 1px solid rgba(184, 178, 168, 0.35);
  }

  .hero-video-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.3s ease;
  }

  .hero-video-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: 4px;
    background: rgba(184, 178, 168, 0.15);
    border-radius: 999px;
    border: 1px solid rgba(184, 178, 168, 0.25);
    width: fit-content;
    margin-inline: auto;
  }

  .hero-video-btn {
    appearance: none;
    background: transparent;
    border: none;
    outline: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 14px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--color-stone-gray);
    transition: all 0.25s ease;
  }

  .hero-video-btn .btn-indicator {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.4;
    transition: all 0.25s ease;
  }

  .hero-video-btn:hover {
    color: var(--color-charcoal);
  }

  .hero-video-btn.is-active {
    background: var(--color-white);
    color: var(--color-charcoal);
    box-shadow: 0 2px 8px rgba(32, 32, 31, 0.08);
  }

  .hero-video-btn.is-active .btn-indicator {
    background: var(--color-deep-burgundy);
    opacity: 1;
    transform: scale(1.2);
  }

  @media (min-width: 1024px) {
    .hero {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
      gap: var(--space-3xl);
      padding: var(--space-4xl) var(--space-2xl);
      max-width: var(--container-wide);
      margin-inline: auto;
      flex-direction: initial;
    }

    .hero-content {
      margin-inline: 0;
      text-align: left;
    }

    .hero-subtitle {
      margin-inline: 0;
    }

    .hero-actions {
      justify-content: flex-start;
    }

    .hero-image {
      margin-bottom: 0;
    }

    .hero-video-card {
      max-width: 100%;
    }
  }

  .hero-img-photo {
    border-radius: var(--border-radius-sm);
    box-shadow: var(--shadow-lg);
    object-fit: cover;
    aspect-ratio: 16 / 10;
  }

  .sensory-infographic-wrapper {
    max-width: 900px;
    margin-inline: auto;
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: var(--color-white);
    border: 1px solid rgba(184, 178, 168, 0.4);
  }

  .sensory-infographic-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* ==========================================================================
     SECTION HEADERS (REUSABLE)
     ========================================================================== */
  .section-header {
    text-align: center;
    max-width: 700px;
    margin-inline: auto;
    margin-bottom: var(--space-3xl);
  }

  .section-header h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 300;
    line-height: var(--line-height-snug);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-sm);
    color: inherit;
  }

  .section-header p {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.2vw, 1.125rem);
    font-weight: 300;
    line-height: var(--line-height-normal);
    color: var(--color-carbon-light);
  }

  /* ==========================================================================
     FEATURED PRODUCTS SECTION
     ========================================================================== */
  .products-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 640px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-xl);
    }
  }

  @media (min-width: 1024px) {
    .products-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-2xl);
    }
  }

  .product-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
    border: 1px solid rgba(184, 178, 168, 0.3);
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-base),
                box-shadow var(--transition-base),
                border-color var(--transition-base);
    height: 100%;
  }

  .product-card:hover {
    text-decoration: none;
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-burgundy);
  }

  .product-card-image {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5.3;
    background-color: var(--color-ivory-dark);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-card:hover .product-card-image img {
    transform: scale(1.05);
  }

  .product-card-info {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .product-card-family {
    font-size: var(--font-size-xs);
    font-family: var(--font-body);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    color: var(--color-stone-text, #6B665E);
    font-weight: 500;
    margin-bottom: var(--space-xs);
  }

  .product-card-name {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: 400;
    line-height: var(--line-height-snug);
    color: var(--color-carbon);
    margin-bottom: var(--space-xs);
    transition: color var(--transition-fast);
  }

  .product-card:hover .product-card-name {
    color: var(--color-burgundy);
  }

  .product-card-desc {
    font-size: var(--font-size-sm);
    color: var(--color-carbon-light);
    line-height: var(--line-height-normal);
    font-weight: 300;
    margin-bottom: var(--space-md);
    flex-grow: 1;
  }

  .product-card-price {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    font-weight: 600;
    color: var(--color-carbon);
    margin-top: auto;
  }

  .section-cta {
    text-align: center;
    margin-top: var(--space-3xl);
  }

  /* ==========================================================================
     BRAND STORY SECTION
     ========================================================================== */
  .brand-story {
    background-color: var(--color-carbon);
    color: var(--color-ivory);
  }

  .brand-story-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .brand-story-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-4xl);
    }
  }

  .brand-story-content h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3.25rem);
    font-weight: 300;
    line-height: var(--line-height-snug);
    margin-block: var(--space-xs) var(--space-lg);
    color: var(--color-ivory);
  }

  .brand-story-content p {
    color: #D2CFC8;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    font-weight: 300;
    line-height: 1.7;
    margin-bottom: var(--space-2xl);
    max-width: 540px;
  }

  .brand-story-content .btn--outline:hover {
    background-color: var(--color-ivory) !important;
    color: var(--color-carbon) !important;
  }

  .brand-story-image {
    width: 100%;
    border-radius: var(--border-radius-sm);
    overflow: hidden;
  }

  .brand-story-image img {
    width: 100%;
    height: auto;
    border-radius: var(--border-radius-sm);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .brand-story-image:hover img {
    transform: scale(1.02);
  }

  /* ==========================================================================
     FRAGRANCE FINDER / DISCOVERY SECTION
     ========================================================================== */
  .finder {
    max-width: 860px;
    margin-inline: auto;
    background-color: var(--color-white);
    border: 1px solid rgba(184, 178, 168, 0.35);
    border-radius: var(--border-radius-md);
    padding: var(--space-2xl) var(--space-lg);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 640px) {
    .finder {
      padding: var(--space-3xl) var(--space-2xl);
    }
  }

  .finder-steps {
    position: relative;
    width: 100%;
  }

  .finder-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    animation: finderFadeIn 0.4s ease forwards;
  }

  .finder-step-badge {
