    color: var(--color-carbon);
  }

  .set-card-savings {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-burgundy);
    background-color: rgba(84, 43, 53, 0.08);
    padding: 0.25rem 0.5rem;
    border-radius: var(--border-radius-sm);
  }

  .set-card-content .btn {
    width: 100%;
    text-align: center;
  }

  /* ==========================================================================
     JOURNAL TEASER SECTION
     ========================================================================== */
  .journal-teaser {
    max-width: 960px;
    margin-inline: auto;
  }

  .journal-teaser-card {
    display: grid;
    grid-template-columns: 1fr;
    background-color: var(--color-white);
    border: 1px solid rgba(184, 178, 168, 0.35);
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-base),
                box-shadow var(--transition-base),
                border-color var(--transition-base);
  }

  @media (min-width: 768px) {
    .journal-teaser-card {
      grid-template-columns: 1.15fr 1fr;
      align-items: stretch;
    }
  }

  .journal-teaser-card:hover {
    text-decoration: none;
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-stone);
  }

  .journal-teaser-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 16 / 10;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .journal-teaser-card:hover img {
    transform: scale(1.03);
  }

  .journal-teaser-content {
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .journal-teaser-content h3 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 400;
    line-height: var(--line-height-snug);
    color: var(--color-carbon);
    margin-block: var(--space-xs) var(--space-sm);
    transition: color var(--transition-fast);
  }

  .journal-teaser-card:hover .journal-teaser-content h3 {
    color: var(--color-burgundy);
  }

  .journal-read-more {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    color: var(--color-burgundy);
    margin-top: var(--space-md);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: transform var(--transition-fast);
  }

  .journal-teaser-card:hover .journal-read-more {
    transform: translateX(4px);
  }

  /* ==========================================================================
     SCROLL REVEAL INTEGRATION
     ========================================================================== */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity var(--transition-reveal, 800ms cubic-bezier(0.16, 1, 0.3, 1)),
                transform var(--transition-reveal, 800ms cubic-bezier(0.16, 1, 0.3, 1));
    will-change: opacity, transform;
  }

  .reveal.revealed,
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .hero-ambient-canvas {
      animation: none !important;
      transform: scale(1.04) !important;
    }

    .hero-image img,
    .product-card-image img,
    .journal-teaser-card img,
    .brand-story-image img {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  import { products, formatPrice } from '../data/products';

  // Hero Video Switcher
  const ambientVideo = document.getElementById('hero-ambient-video') as HTMLVideoElement | null;
  const videoControlBtns = document.querySelectorAll<HTMLButtonElement>('.hero-video-btn');

  if (ambientVideo && videoControlBtns.length > 0) {
    videoControlBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const newSrc = btn.getAttribute('data-video-src');
        const newPoster = btn.getAttribute('data-poster-src');
        if (!newSrc || ambientVideo.getAttribute('src') === newSrc) return;

        videoControlBtns.forEach(b => {
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');

        ambientVideo.style.opacity = '0';
        setTimeout(() => {
          if (newPoster) ambientVideo.poster = newPoster;
          ambientVideo.src = newSrc;
          ambientVideo.load();
          ambientVideo.play().catch(() => {});
          ambientVideo.style.opacity = '1';
        }, 220);
      });
    });
  }

  // Fragrance Finder State
  let selectedFamily: string | null = null;
  let selectedIntensity: string | null = null;
  let selectedOccasion: string | null = null;

  const finder = document.querySelector('[data-finder]');
  if (finder) {
    const step1 = finder.querySelector('[data-step="1"]') as HTMLElement | null;
    const step2 = finder.querySelector('[data-step="2"]') as HTMLElement | null;
    const step3 = finder.querySelector('[data-step="3"]') as HTMLElement | null;
    const resultsContainer = finder.querySelector('[data-finder-results]') as HTMLElement | null;

    // Helper to normalize strings for comparison
    function normalize(str: string): string {
      return str
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim();
    }

    // Step 1: Family selection
    const familyButtons = finder.querySelectorAll<HTMLButtonElement>('[data-family]');
    familyButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        selectedFamily = target.dataset.family || null;

        if (step1) step1.style.display = 'none';
        if (step2) step2.style.display = 'flex';
      });
    });

    // Step 2: Intensity selection
    const intensityButtons = finder.querySelectorAll<HTMLButtonElement>('[data-intensity]');
    intensityButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        selectedIntensity = target.dataset.intensity || null;

        if (step2) step2.style.display = 'none';
        if (step3) step3.style.display = 'flex';
      });
    });

    // Step 3: Occasion selection
    const occasionButtons = finder.querySelectorAll<HTMLButtonElement>('[data-occasion]');
    occasionButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        selectedOccasion = target.dataset.occasion || null;

        if (step3) step3.style.display = 'none';
        renderResults();
      });
    });

    // Back buttons
    const backButtons = finder.querySelectorAll<HTMLButtonElement>('[data-finder-back]');
    backButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const toStep = target.dataset.finderBack;
        if (toStep === '1') {
          if (step2) step2.style.display = 'none';
          if (step1) step1.style.display = 'flex';
        } else if (toStep === '2') {
          if (step3) step3.style.display = 'none';
          if (step2) step2.style.display = 'flex';
        }
      });
    });

    function renderResults() {
      if (!resultsContainer) return;

      const normFamily = selectedFamily ? normalize(selectedFamily) : '';
      const normIntensity = selectedIntensity ? normalize(selectedIntensity) : '';
      const normOccasion = selectedOccasion ? normalize(selectedOccasion) : '';

      const matchedProducts = products.filter(p => {
        // Family filter
        if (normFamily && normFamily !== 'all') {
          const pFamily = normalize(p.family);
          const pTags = p.tags.map(normalize);
          const matchesFamily =
            pFamily.includes(normFamily) ||
            pTags.some(t => t.includes(normFamily)) ||
            (normFamily === 'amaderadas' && (pFamily.includes('amaderada') || pTags.includes('amaderada'))) ||
            (normFamily === 'ambar-especiadas' && (pFamily.includes('ambar') || pFamily.includes('especiada') || pTags.includes('ambar') || pTags.includes('especiada'))) ||
            (normFamily === 'florales' && (pFamily.includes('floral') || pTags.includes('floral'))) ||
            (normFamily === 'almizcladas' && (pFamily.includes('almizclada') || pTags.includes('almizclada'))) ||
            (normFamily === 'frescas' && (pFamily.includes('fresca') || pTags.includes('fresca')));

          if (!matchesFamily) return false;
        }

        // Intensity filter
        if (normIntensity && normIntensity !== 'all' && normIntensity !== 'todas') {
          const pIntensity = normalize(p.intensity);
          if (!pIntensity.includes(normIntensity)) return false;
        }

        // Occasion filter
        if (normOccasion && normOccasion !== 'all' && normOccasion !== 'todas') {
          const pOccasion = normalize(p.occasion);
          const pTags = p.tags.map(normalize);
          const matchesOccasion =
            pOccasion.includes(normOccasion) ||
            pTags.some(t => t.includes(normOccasion)) ||
            (normOccasion === 'noche' && (pTags.includes('noche') || pTags.includes('eventos') || pOccasion.includes('eventos') || pOccasion.includes('especiales')));
          if (!matchesOccasion) return false;
        }

        return true;
      });

      resultsContainer.style.display = 'block';

      if (matchedProducts.length === 0) {
        resultsContainer.innerHTML = `
          <div class="finder-empty">
            <span class="text-label" style="margin-bottom: var(--space-xs);">Sin coincidencias exactas</span>
            <h3>Tu esencia única espera ser descubierta</h3>
            <p>No encontramos una coincidencia exacta para esta combinación de notas y momentos, pero te invitamos a explorar nuestro catálogo completo o reiniciar el selector con otras preferencias.</p>
            <div class="finder-actions">
              <button type="button" class="btn btn--outline" data-finder-reset>Reiniciar selector</button>
              <a href="/perfumes" class="btn btn--primary">Explorar catálogo completo</a>
            </div>
          </div>
        `;
      } else {
        resultsContainer.innerHTML = `
          <div class="finder-results-header">
            <span class="text-label">Resultado personalizado</span>
            <h3>Fragancias recomendadas para vos</h3>
            <p>Seleccionadas según tus preferencias olfativas y forma de expresión.</p>
          </div>
          <div class="finder-results-grid">
            ${matchedProducts.map(product => `
              <a href="/perfumes/${product.slug}" class="product-card">
                <div class="product-card-image">
                  <img src="${product.image}" alt="${product.name}" width="400" height="530" loading="lazy" />
                </div>
                <div class="product-card-info">
                  <span class="product-card-family">${product.family}</span>
                  <h3 class="product-card-name">${product.name}</h3>
                  <p class="product-card-desc">${product.shortDescription}</p>
                  <span class="product-card-price">${formatPrice(product.price)}</span>
                </div>
              </a>
            `).join('')}
          </div>
          <div class="finder-actions">
            <button type="button" class="btn btn--outline" data-finder-reset>Reiniciar selector</button>
            <a href="/perfumes" class="btn btn--primary">Ver todo el catálogo</a>
          </div>
        `;
      }

      // Re-attach reset handler
      const resetButtons = resultsContainer.querySelectorAll<HTMLButtonElement>('[data-finder-reset]');
      resetButtons.forEach(btn => {
        btn.addEventListener('click', resetFinder);
      });
    }

    function resetFinder() {
      selectedFamily = null;
      selectedIntensity = null;
      selectedOccasion = null;

      if (resultsContainer) {
        resultsContainer.style.display = 'none';
        resultsContainer.innerHTML = '';
      }
      if (step3) step3.style.display = 'none';
      if (step2) step2.style.display = 'none';
      if (step1) step1.style.display = 'flex';
    }
  }
</script>
