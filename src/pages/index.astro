    margin-top: var(--space-xl);
  }

  @keyframes finderFadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ==========================================================================
     GIFT SETS SECTION
     ========================================================================== */
  .sets {
    background-color: var(--color-ivory-dark, #E8E2D8);
  }

  .sets-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 640px) {
    .sets-grid {
