---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogArticles } from '../../data/articles';

export function getStaticPaths() {
  return blogArticles.map((a) => ({
    params: { slug: a.slug },
    props: { article: a },
  }));
}

const { article } = Astro.props;

// Other blog articles for recommended reading
const relatedArticles = blogArticles.filter((a) => a.slug !== article.slug).slice(0, 2);

function formatDate(dateStr: string): string {
  try {
    const [year, month, day] = dateStr.split('-').map(Number);
    const date = new Date(year, month - 1, day);
    return date.toLocaleDateString('es-AR', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  } catch {
    return dateStr;
  }
}

function convertMarkdownToHtml(markdown: string): string {
  if (!markdown) return '';

  const escapeHtml = (text: string) => {
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  };

  const formatInline = (text: string) => {
    let escaped = escapeHtml(text);
    // Links: [text](url)
    escaped = escaped.replace(
      /\[([^\]]+)\]\(([^)]+)\)/g,
      '<a href="$2" class="article-link">$1</a>'
    );
    // Bold: **text**
    escaped = escaped.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    // Italic: *text*
    escaped = escaped.replace(/\*([^*]+)\*/g, '<em>$1</em>');
    return escaped;
  };

  const lines = markdown.trim().split('\n');
  const blocks: string[] = [];
  let currentList: { type: 'ul' | 'ol'; items: string[] } | null = null;
  let currentParagraph: string[] = [];

  const flushParagraph = () => {
    if (currentParagraph.length > 0) {
      const text = currentParagraph.join(' ').trim();
      if (text) {
        blocks.push(`<p>${formatInline(text)}</p>`);
      }
      currentParagraph = [];
    }
  };

  const flushList = () => {
    if (currentList) {
      const tag = currentList.type;
      const itemsHtml = currentList.items
        .map((item) => `<li>${formatInline(item)}</li>`)
        .join('');
      blocks.push(`<${tag}>${itemsHtml}</${tag}>`);
      currentList = null;
    }
  };

  for (let i = 0; i < lines.length; i++) {
    const rawLine = lines[i];
    const line = rawLine.trim();

    if (!line) {
      flushParagraph();
      flushList();
      continue;
    }

    if (line.startsWith('### ')) {
      flushParagraph();
      flushList();
      blocks.push(`<h3>${formatInline(line.slice(4))}</h3>`);
      continue;
    }

    if (line.startsWith('## ')) {
      flushParagraph();
      flushList();
      blocks.push(`<h2>${formatInline(line.slice(3))}</h2>`);
      continue;
    }

    if (line.startsWith('# ')) {
      flushParagraph();
      flushList();
      blocks.push(`<h2>${formatInline(line.slice(2))}</h2>`);
      continue;
    }

    if (line.startsWith('> ')) {
      flushParagraph();
      flushList();
      blocks.push(`<blockquote><p>${formatInline(line.slice(2))}</p></blockquote>`);
      continue;
    }

    if (line.startsWith('- ') || line.startsWith('* ')) {
      flushParagraph();
      if (!currentList || currentList.type !== 'ul') {
        flushList();
        currentList = { type: 'ul', items: [] };
      }
      currentList.items.push(line.slice(2));
      continue;
    }

    const olMatch = line.match(/^(\d+)\.\s+(.*)/);
    if (olMatch) {
      flushParagraph();
      if (!currentList || currentList.type !== 'ol') {
        flushList();
        currentList = { type: 'ol', items: [] };
      }
      currentList.items.push(olMatch[2]);
      continue;
    }

    if (currentList) {
      flushList();
    }
    currentParagraph.push(line);
  }

  flushParagraph();
  flushList();

  return blocks.join('\n');
}

const htmlContent = convertMarkdownToHtml(article.content);
---

<BaseLayout
  title={article.title}
  description={article.metaDescription || article.excerpt}
  ogImage={article.image}
>
  <article class="article-detail-page section-padding--lg bg-ivory">
    <div class="container--narrow">
      <!-- Breadcrumb -->
      <nav class="breadcrumb reveal" aria-label="Ruta de navegación">
        <ol class="breadcrumb-list">
          <li><a href="/">Inicio</a></li>
          <li class="breadcrumb-separator" aria-hidden="true">/</li>
          <li><a href="/blog">Blog</a></li>
          <li class="breadcrumb-separator" aria-hidden="true">/</li>
          <li class="breadcrumb-current" aria-current="page">{article.category}</li>
        </ol>
      </nav>

      <!-- Article Header -->
      <header class="article-header reveal reveal-delay-1">
        <div class="article-category-wrapper">
          <span class="badge badge--burgundy">{article.category}</span>
        </div>

        <h1 class="article-detail-title">{article.title}</h1>

        <div class="article-meta-bar">
          <div class="meta-item author-item">
            <span class="meta-label">Por</span>
            <span class="meta-value">{article.author}</span>
          </div>
          <span class="meta-separator" aria-hidden="true">·</span>
          <div class="meta-item date-item">
            <time datetime={article.date}>{formatDate(article.date)}</time>
          </div>
          <span class="meta-separator" aria-hidden="true">·</span>
          <div class="meta-item readtime-item">
            <span>{article.readTime} de lectura</span>
          </div>
        </div>

        {article.excerpt && (
          <p class="article-lead-excerpt lead">{article.excerpt}</p>
        )}
      </header>

      <!-- Featured Image -->
      <div class="article-featured-image-wrapper reveal reveal-delay-2">
        <img
          src={article.image}
          alt={article.imageAlt}
          class="article-featured-image"
          width="800"
          height="450"
          loading="eager"
        />
        {article.imageAlt && (
          <figcaption class="article-image-caption">
            {article.imageAlt}
          </figcaption>
        )}
      </div>

      <!-- Article Body Content -->
      <div class="article-content-wrapper reveal reveal-delay-3">
        <div class="article-content" set:html={htmlContent} />
      </div>

      <!-- Article Tags -->
      {article.tags && article.tags.length > 0 && (
        <div class="article-tags-section reveal">
          <span class="tags-heading">Temas:</span>
          <ul class="tags-list" aria-label="Etiquetas de la nota">
            {article.tags.map((tag) => (
              <li>
                <span class="tag-pill">#{tag}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Article Navigation Buttons -->
      <footer class="article-footer-nav reveal">
        <a href="/blog" class="btn btn--outline">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Volver al Blog</span>
        </a>

        <a href="/perfumes" class="btn btn--primary">
          <span>Explorar Catálogo</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </footer>

      <!-- Related Blog Reads -->
      {relatedArticles.length > 0 && (
        <section class="related-articles-section reveal">
          <h2 class="related-heading">Otras notas recomendadas</h2>
          <div class="related-grid">
            {relatedArticles.map((rel) => (
              <a href={`/blog/${rel.slug}`} class="related-card">
                <span class="related-category">{rel.category}</span>
                <h3 class="related-title">{rel.title}</h3>
                <span class="related-meta">{rel.readTime} de lectura · {formatDate(rel.date)}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Academic Context Note -->
      <aside class="article-academic-note reveal">
        <p>
          <strong>VI-ELIXIR · Nota académica:</strong> Las notas y comparativas de fragancias de este blog son ejercicios descriptivos de identidad de producto para la cátedra de Comercio Electrónico.
        </p>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  /* ==========================================================================
     Blog Article Detail — Scoped Styles
     ========================================================================== */

  .article-detail-page {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-5xl);
  }

  /* Breadcrumb */
  .breadcrumb {
    margin-bottom: var(--space-xl);
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-stone);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .breadcrumb-list a {
    color: var(--color-carbon-light);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb-list a:hover {
    color: var(--color-burgundy);
    text-decoration: underline;
  }

  .breadcrumb-separator {
    color: var(--color-stone);
    opacity: 0.5;
  }

  .breadcrumb-current {
    color: var(--color-burgundy);
    font-weight: var(--font-weight-medium);
  }

  /* Header */
  .article-header {
    margin-bottom: var(--space-2xl);
  }

  .article-category-wrapper {
    margin-bottom: var(--space-sm);
  }

  .article-detail-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: var(--font-weight-light);
    line-height: 1.15;
    letter-spacing: var(--letter-spacing-tight);
    margin-bottom: var(--space-lg);
    color: var(--color-carbon);
  }

  .article-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    color: var(--color-stone-text, #6B665E);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid rgba(184, 178, 168, 0.3);
    margin-bottom: var(--space-xl);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .meta-value {
    color: var(--color-carbon);
    font-weight: var(--font-weight-medium);
  }

  .meta-separator {
    color: var(--color-stone);
    opacity: 0.6;
  }

  .article-lead-excerpt {
    font-size: var(--font-size-lg);
    line-height: 1.7;
    color: var(--color-carbon-light);
    font-style: italic;
    font-family: var(--font-display);
    border-left: 2px solid var(--color-burgundy);
    padding-left: var(--space-md);
    margin-top: var(--space-lg);
    margin-bottom: 0;
  }

  /* Featured Image */
  .article-featured-image-wrapper {
    margin-bottom: var(--space-3xl);
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    background-color: var(--color-carbon);
    border: 1px solid rgba(184, 178, 168, 0.3);
  }

  .article-featured-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .article-image-caption {
    font-size: var(--font-size-xs);
    color: var(--color-stone);
    background-color: var(--color-ivory-dark);
    padding: var(--space-xs) var(--space-md);
    text-align: center;
    font-style: italic;
  }

  /* Article Content Typography (Narrow container, max-width 800px) */
  .article-content-wrapper {
    margin-bottom: var(--space-3xl);
  }

  .article-content {
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--color-carbon);
  }

  .article-content :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: var(--font-weight-light);
    line-height: 1.25;
    margin-top: var(--space-3xl);
    margin-bottom: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(184, 178, 168, 0.25);
    color: var(--color-carbon);
  }

  .article-content :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .article-content :global(h3) {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    font-weight: var(--font-weight-regular);
    line-height: 1.3;
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-sm);
    color: var(--color-carbon);
  }

  .article-content :global(p) {
    margin-bottom: var(--space-lg);
    color: var(--color-carbon);
    font-weight: var(--font-weight-regular);
  }

  .article-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .article-content :global(strong) {
    font-weight: var(--font-weight-semibold);
    color: var(--color-carbon);
  }

  .article-content :global(em) {
    font-style: italic;
  }

  .article-content :global(a.article-link) {
    color: var(--color-burgundy);
    text-decoration: underline;
    text-decoration-color: rgba(84, 43, 53, 0.4);
    text-underline-offset: 3px;
    font-weight: var(--font-weight-medium);
    transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
  }

  .article-content :global(a.article-link:hover) {
    color: var(--color-burgundy-light);
    text-decoration-color: var(--color-burgundy-light);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-xl);
    padding-left: var(--space-xl);
  }

  .article-content :global(li) {
    margin-bottom: var(--space-sm);
    line-height: 1.75;
    padding-left: var(--space-xs);
  }

  .article-content :global(blockquote) {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-style: italic;
    line-height: 1.6;
    padding-left: var(--space-xl);
    border-left: 2px solid var(--color-burgundy);
    margin: var(--space-2xl) 0;
    color: var(--color-carbon-light);
  }

  /* Tags Section */
  .article-tags-section {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    padding-top: var(--space-xl);
    border-top: 1px solid rgba(184, 178, 168, 0.3);
    margin-bottom: var(--space-3xl);
  }

  .tags-heading {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    color: var(--color-stone);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tag-pill {
    display: inline-block;
    font-size: var(--font-size-xs);
    padding: 0.25rem 0.625rem;
    border-radius: var(--border-radius-sm);
    background-color: var(--color-ivory-dark);
    color: var(--color-carbon);
    letter-spacing: var(--letter-spacing-wide);
  }

  /* Footer Navigation */
  .article-footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-3xl);
    border-bottom: 1px solid rgba(184, 178, 168, 0.25);
    margin-bottom: var(--space-3xl);
  }

  /* Related Articles */
  .related-articles-section {
    margin-bottom: var(--space-3xl);
  }

  .related-heading {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-light);
    margin-bottom: var(--space-xl);
    color: var(--color-carbon);
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 640px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .related-card {
    background-color: var(--color-ivory-dark);
    border: 1px solid rgba(184, 178, 168, 0.3);
    border-radius: var(--border-radius-sm);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .related-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-burgundy);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
  }

  .related-category {
    font-size: 0.6875rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-widest);
    text-transform: uppercase;
    color: var(--color-burgundy);
    margin-bottom: var(--space-xs);
  }

  .related-title {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-snug);
    color: var(--color-carbon);
    margin-bottom: var(--space-md);
  }

  .related-meta {
    font-size: var(--font-size-xs);
    color: var(--color-stone);
    margin-top: auto;
  }

  /* Academic Note */
  .article-academic-note {
    background-color: rgba(255, 255, 255, 0.6);
    border: 1px dashed var(--color-stone);
    border-radius: var(--border-radius-sm);
    padding: var(--space-md) var(--space-lg);
  }

  .article-academic-note p {
    font-size: var(--font-size-xs);
    line-height: 1.6;
    color: var(--color-carbon-light);
    margin: 0;
  }

  @media (max-width: 639px) {
    .article-footer-nav {
      flex-direction: column;
    }

    .article-footer-nav .btn {
      width: 100%;
    }

    .article-meta-bar {
      gap: var(--space-xs);
    }
  }
</style>
