---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import {
  products,
  mainCategories,
  olfactoryFamilies,
  formatPrice,
  getMainCategoryById,
  getSubCategoryById,
  getOlfactoryFamilyBySlug,
} from '../../data/products';
---

<BaseLayout
  title="Catálogo de Perfumes"
  description="Explorá la colección de perfumes árabes de VI-ELIXIR organizados por categorías principales, subcategorías y familias olfativas."
>
  <!-- Page Header -->
  <header class="catalog-header">
    <div class="container">
      <nav class="catalog-breadcrumb" id="catalog-breadcrumb" aria-label="Miga de pan">
        <a href="/">Inicio</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <a href="/perfumes" id="bc-perfumes-link">Perfumes</a>
        <span id="bc-dynamic-container"></span>
      </nav>

      <span class="catalog-eyebrow text-label">Alta Perfumería de Autor · Organización Jerárquica</span>
      <h1 class="catalog-title" id="catalog-main-title">Nuestras fragancias</h1>
      <p class="catalog-subtitle lead" id="catalog-main-subtitle">
        Composiciones olfativas concebidas a partir de materias primas nobles de la tradición oriental.
        Oud ahumado, resinas de ámbar, azafrán milenario y rosas aterciopeladas en interpretaciones
        contemporáneas clasificadas por categoría, subcategoría y familia olfativa.
      </p>

      <!-- Category Navigation Tabs (CATEGORÍA PRINCIPAL) -->
      <div class="category-tabs-wrapper">
        <div class="category-tabs" role="tablist" aria-label="Categorías principales">
          <button
            type="button"
            class="category-tab active"
            data-cat-tab=""
            role="tab"
            aria-selected="true"
          >
            Todas las fragancias <span class="tab-count">({products.length})</span>
          </button>
          {mainCategories.map((cat) => {
            const count = products.filter((p) => p.categoriaPrincipalId === cat.id).length;
            return (
              <button
                type="button"
                class="category-tab"
                data-cat-tab={cat.slug}
                role="tab"
                aria-selected="false"
              >
                {cat.name} <span class="tab-count">({count})</span>
              </button>
            );
          })}
        </div>
      </div>

      <!-- Subcategory Navigation Chips (SUBCATEGORÍAS) -->
      <div class="subcategory-chips-bar" id="subcategory-chips-bar" aria-label="Filtro por subcategoría">
        <span class="chips-label">Subcategorías:</span>
        <div class="chips-scroll">
          <button
            type="button"
            class="subcat-chip active"
            data-subcat-chip=""
            data-parent-cat="all"
          >
            Todas
          </button>
          {mainCategories.flatMap((cat) =>
            cat.subcategories.map((sub) => (
              <button
                type="button"
                class="subcat-chip"
                data-subcat-chip={sub.slug}
                data-parent-cat={cat.slug}
                title={`Subcategoría de ${cat.name}`}
              >
                {sub.name}
              </button>
            ))
          )}
        </div>
      </div>
    </div>
  </header>

  <div class="catalog-main section-padding">
    <div class="container">
      <!-- Filter Bar (Secondary filters: Olfactory Family, Intensity, Occasion, Sort) -->
      <section class="filter-section" aria-label="Filtros complementarios">
        <form class="filter-bar" id="filter-form" onsubmit="return false;">
          <div class="filter-controls">
            <!-- Olfactory Family Filter -->
            <div class="filter-group">
              <label for="filter-family" class="filter-label">Familia Olfativa</label>
              <div class="select-wrapper">
                <select id="filter-family" name="familia" class="filter-select">
                  <option value="">Todas las familias</option>
                  {olfactoryFamilies.map((fam) => (
                    <option value={fam.slug}>{fam.name}</option>
                  ))}
                </select>
                <svg class="select-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </div>
            </div>

            <!-- Intensity Filter -->
            <div class="filter-group">
              <label for="filter-intensity" class="filter-label">Intensidad</label>
              <div class="select-wrapper">
                <select id="filter-intensity" name="intensity" class="filter-select">
                  <option value="">Todas las intensidades</option>
                  <option value="Suave">Suave</option>
                  <option value="Moderada">Moderada</option>
                  <option value="Moderada-Intensa">Moderada-Intensa</option>
                  <option value="Intensa">Intensa</option>
                </select>
                <svg class="select-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </div>
            </div>

            <!-- Occasion Filter -->
            <div class="filter-group">
              <label for="filter-occasion" class="filter-label">Ocasión</label>
              <div class="select-wrapper">
                <select id="filter-occasion" name="occasion" class="filter-select">
                  <option value="">Todas las ocasiones</option>
                  <option value="dia">Día / Uso diario</option>
                  <option value="noche">Noche / Salidas</option>
                </select>
                <svg class="select-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </div>
            </div>

            <!-- Sort By Control -->
            <div class="filter-group">
              <label for="filter-sort" class="filter-label">Ordenar por</label>
              <div class="select-wrapper">
                <select id="filter-sort" name="sort" class="filter-select">
                  <option value="featured">Destacados</option>
                  <option value="price-asc">Precio: menor a mayor</option>
                  <option value="price-desc">Precio: mayor a menor</option>
                  <option value="name-asc">Nombre: A a Z</option>
                </select>
                <svg class="select-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </div>
            </div>
          </div>

          <!-- Counter and Clear action -->
          <div class="filter-meta">
            <span class="results-count" id="results-count" aria-live="polite">
              Mostrando {products.length} fragancias
            </span>
            <button
              type="button"
              class="clear-filters-btn"
              id="clear-filters"
              aria-label="Restablecer todos los filtros"
            >
              Restablecer filtros
            </button>
          </div>
        </form>

        <!-- Active Filter Pills -->
        <div class="active-filters-bar" id="active-filters-bar" style="display: none;">
          <span class="active-filters-label">Filtros activos:</span>
          <div class="active-pills-list" id="active-pills-list"></div>
          <button type="button" class="clear-all-pills-btn" id="clear-all-pills">Limpiar todo</button>
        </div>
      </section>

      <!-- Products Grid -->
      <section class="products-section" aria-label="Listado de perfumes">
        <ul class="product-grid" id="product-grid" role="list">
          {products.map((product) => {
            return (
              <li
                class="product-item"
                data-product-item
                data-slug={product.slug}
                data-sku={product.sku}
                data-price={product.price}
                data-name={product.name}
                data-category-id={product.categoriaPrincipalId}
                data-subcategory-id={product.subcategoriaId}
                data-family-ids={(product.familiasOlfativasSlugs || []).join(' ')}
                data-family={product.family}
                data-intensity={product.intensity}
                data-occasion={product.occasion}
                data-tags={product.tags.join(' ')}
              >
                <ProductCard
                  name={product.name}
                  slug={product.slug}
                  sku={product.sku}
                  image={product.image}
                  family={product.family}
                  category={product.categoriaPrincipal}
                  subcategory={product.subcategoria}
                  shortDescription={product.shortDescription}
                  price={product.price}
                />
              </li>
            );
          })}
        </ul>

        <!-- Empty State -->
        <div class="empty-state" id="empty-state" style="display: none;" aria-live="polite">
          <div class="empty-state-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
          </div>
          <h2 class="empty-state-title">No encontramos fragancias con esos criterios</h2>
          <p class="empty-state-desc">
            Probá seleccionando otra categoría o limpiando los filtros para descubrir todas las creaciones de nuestra colección.
          </p>
          <button type="button" class="btn btn--outline" id="empty-clear-btn">
            Ver todas las fragancias
          </button>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* Header */
  .catalog-header {
    background-color: var(--color-ivory);
    border-bottom: 1px solid var(--color-ivory-dark);
    padding-top: calc(var(--header-height) + var(--space-xl));
    padding-bottom: var(--space-2xl);
  }

  .catalog-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--font-size-xs);
    color: var(--color-stone-text, #6B665E);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-widest);
    margin-bottom: var(--space-md);
  }

  .catalog-breadcrumb a {
    color: var(--color-stone-text, #6B665E);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .catalog-breadcrumb a:hover {
    color: var(--color-burgundy);
    text-decoration: underline;
  }

  .breadcrumb-sep {
    color: var(--color-stone);
    opacity: 0.6;
  }

  .catalog-breadcrumb [aria-current="page"] {
    color: var(--color-burgundy);
    font-weight: var(--font-weight-medium);
  }

  .catalog-eyebrow {
    color: var(--color-burgundy);
    margin-bottom: var(--space-xs);
  }

  .catalog-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: var(--font-weight-light);
    color: var(--color-carbon);
    line-height: 1.15;
    margin-bottom: var(--space-md);
  }

  .catalog-subtitle {
    max-width: 780px;
    color: var(--color-carbon-light);
    font-size: var(--font-size-base);
    line-height: var(--line-height-normal);
    margin-bottom: var(--space-xl);
  }

  /* Category Tabs (Nivel 1: Categorías Principales) */
  .category-tabs-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-bottom: var(--space-md);
    padding-bottom: 4px;
  }

  .category-tabs {
    display: flex;
    gap: var(--space-sm);
    min-width: max-content;
  }

  .category-tab {
    font-family: var(--font-display);
    font-size: var(--font-size-base);
    padding: var(--space-sm) var(--space-lg);
    background: transparent;
    border: 1px solid rgba(184, 178, 168, 0.4);
    border-radius: var(--border-radius-full);
    color: var(--color-carbon);
    cursor: pointer;
    transition: all var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .category-tab:hover {
    border-color: var(--color-burgundy);
    color: var(--color-burgundy);
  }

  .category-tab.active {
    background: var(--color-carbon);
    border-color: var(--color-carbon);
    color: var(--color-ivory);
  }

  .tab-count {
    font-size: var(--font-size-xs);
    opacity: 0.8;
  }

  /* Subcategory Chips (Nivel 2: Subcategorías) */
  .subcategory-chips-bar {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-top: var(--space-sm);
    flex-wrap: wrap;
  }

  .chips-label {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-widest);
    color: var(--color-stone-text, #6B665E);
    font-weight: 600;
  }

  .chips-scroll {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .subcat-chip {
    font-size: var(--font-size-xs);
    padding: 6px 12px;
    background: var(--color-white);
    border: 1px solid rgba(184, 178, 168, 0.35);
    border-radius: var(--border-radius-sm);
    color: var(--color-stone-text, #6B665E);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .subcat-chip:hover {
    border-color: var(--color-burgundy);
    color: var(--color-burgundy);
  }

  .subcat-chip.active {
    background: var(--color-burgundy);
    border-color: var(--color-burgundy);
    color: var(--color-white);
  }

  .subcat-chip.is-hidden-parent {
    display: none !important;
  }

  /* Filter Section */
  .catalog-main {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-5xl);
  }

  .filter-section {
    margin-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-ivory-dark);
    padding-bottom: var(--space-lg);
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .filter-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-md);
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 155px;
  }

  .filter-label {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-widest);
    color: var(--color-stone-text, #6B665E);
  }

  .select-wrapper {
    position: relative;
    width: 100%;
  }

  .filter-select {
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
    background-color: var(--color-white);
    border: 1px solid var(--color-stone);
    border-radius: var(--border-radius-sm);
    padding: var(--space-sm) var(--space-xl) var(--space-sm) var(--space-md);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-carbon);
    cursor: pointer;
    transition: border-color var(--transition-fast);
  }

  .filter-select:focus-visible {
    outline: 2px solid var(--color-burgundy);
    outline-offset: 1px;
    border-color: var(--color-burgundy);
  }

  .select-arrow {
    position: absolute;
    right: var(--space-sm);
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--color-stone-text, #6B665E);
  }

  .filter-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .results-count {
    font-size: var(--font-size-sm);
    color: var(--color-stone-text, #6B665E);
  }

  .clear-filters-btn {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-widest);
    color: var(--color-burgundy);
    cursor: pointer;
    text-decoration: underline;
    transition: opacity var(--transition-fast);
  }

  .clear-filters-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    text-decoration: none;
  }

  /* Active Filter Pills Bar */
  .active-filters-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
  }

  .active-filters-label {
    font-size: var(--font-size-xs);
    color: var(--color-stone-text, #6B665E);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
    font-weight: 500;
  }

  .active-pills-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  :global(.filter-pill) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(84, 43, 53, 0.08);
    border: 1px solid rgba(84, 43, 53, 0.2);
    color: var(--color-burgundy);
    padding: 4px 10px;
    border-radius: var(--border-radius-full);
    font-size: var(--font-size-xs);
    font-weight: 500;
  }

  :global(.filter-pill-remove) {
    background: none;
    border: none;
    color: var(--color-burgundy);
    cursor: pointer;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    line-height: 1;
    opacity: 0.7;
    transition: opacity var(--transition-fast);
  }

  :global(.filter-pill-remove:hover) {
    opacity: 1;
  }

  .clear-all-pills-btn {
    background: none;
    border: none;
    color: var(--color-stone-text, #6B665E);
    font-size: var(--font-size-xs);
    cursor: pointer;
    text-decoration: underline;
    margin-left: var(--space-xs);
  }

  .clear-all-pills-btn:hover {
    color: var(--color-burgundy);
  }

  /* Products Grid */
  .product-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 640px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-2xl) var(--space-xl);
    }
  }

  @media (min-width: 1024px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-3xl) var(--space-xl);
    }
  }

  .product-item {
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .product-item.is-hidden {
    display: none !important;
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: var(--space-4xl) var(--space-lg);
    background-color: var(--color-white);
    border: 1px dashed rgba(184, 178, 168, 0.4);
    border-radius: var(--border-radius-sm);
    max-width: 580px;
    margin: 0 auto;
  }

  .empty-state-icon {
    color: var(--color-stone);
    margin-bottom: var(--space-md);
  }

  .empty-state-title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-regular);
    color: var(--color-carbon);
    margin-bottom: var(--space-sm);
  }

  .empty-state-desc {
    color: var(--color-stone-text, #6B665E);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
    margin-bottom: var(--space-xl);
  }
</style>

<script>
  function initCatalogHierarchy() {
    const catTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-cat-tab]'));
    const subcatChips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-subcat-chip]'));
    const familySelect = document.getElementById('filter-family') as HTMLSelectElement | null;
    const intensitySelect = document.getElementById('filter-intensity') as HTMLSelectElement | null;
    const occasionSelect = document.getElementById('filter-occasion') as HTMLSelectElement | null;
    const sortSelect = document.getElementById('filter-sort') as HTMLSelectElement | null;
    const resultsCount = document.getElementById('results-count');
    const clearBtn = document.getElementById('clear-filters') as HTMLButtonElement | null;
    const emptyClearBtn = document.getElementById('empty-clear-btn') as HTMLButtonElement | null;
    const emptyState = document.getElementById('empty-state');
    const grid = document.getElementById('product-grid');
    const productItems = Array.from(document.querySelectorAll<HTMLLIElement>('[data-product-item]'));
    const bcContainer = document.getElementById('bc-dynamic-container');
    const activeFiltersBar = document.getElementById('active-filters-bar');
    const activePillsList = document.getElementById('active-pills-list');
    const clearAllPillsBtn = document.getElementById('clear-all-pills');

    if (productItems.length === 0) return;

    const totalCount = productItems.length;

    // Mapping labels
    const categoryLabels: Record<string, string> = {
      masculinos: 'Perfumes Masculinos',
      femeninos: 'Perfumes Femeninos',
      unisex: 'Perfumes Unisex',
    };

    const subcategoryLabels: Record<string, string> = {
      'amaderados-intensos': 'Amaderados intensos',
      'ambar-especiados': 'Ámbar y especiados',
      'florales-orientales': 'Florales orientales',
      'ambar-envolventes': 'Ámbar y envolventes',
      'amaderados-contemporaneos': 'Amaderados contemporáneos',
      'almizclados-suaves': 'Almizclados y suaves',
    };

    const familyLabels: Record<string, string> = {
      amaderados: 'Amaderados',
      florales: 'Florales',
      'ambar-especiados': 'Ámbar y especiados',
      almizclados: 'Almizclados',
      frescos: 'Frescos',
    };

    let activeCategory = '';
    let activeSubcategory = '';

    function normalizeText(text: string): string {
      return text
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim();
    }

    function syncStateFromURL() {
      const params = new URLSearchParams(window.location.search);
      activeCategory = params.get('categoria') || params.get('category') || '';
      activeSubcategory = params.get('subcategoria') || params.get('subcategory') || '';
      const fam = params.get('familia') || params.get('family') || '';
      const int = params.get('intensity') || '';
      const occ = params.get('occasion') || '';
      const sort = params.get('sort') || 'featured';

      if (familySelect) familySelect.value = fam;
      if (intensitySelect) intensitySelect.value = int;
      if (occasionSelect) occasionSelect.value = occ;
      if (sortSelect) sortSelect.value = sort;

      updateCategoryTabsUI();
      updateSubcategoryChipsUI();
    }

    function updateCategoryTabsUI() {
      catTabs.forEach((tab) => {
        const catVal = tab.dataset.catTab || '';
        const isSelected = catVal === activeCategory;
        tab.classList.toggle('active', isSelected);
        tab.setAttribute('aria-selected', String(isSelected));
      });
    }

    function updateSubcategoryChipsUI() {
      subcatChips.forEach((chip) => {
        const parentCat = chip.dataset.parentCat || '';
        const chipVal = chip.dataset.subcatChip || '';

        if (activeCategory) {
          if (parentCat === 'all' || parentCat === activeCategory) {
            chip.classList.remove('is-hidden-parent');
          } else {
            chip.classList.add('is-hidden-parent');
          }
        } else {
          chip.classList.remove('is-hidden-parent');
        }

        const isSelected = chipVal === activeSubcategory;
        chip.classList.toggle('active', isSelected);
      });
    }

    function updateURLAndHistory(push: boolean = false) {
      const params = new URLSearchParams();
      if (activeCategory) params.set('categoria', activeCategory);
      if (activeSubcategory) params.set('subcategoria', activeSubcategory);

      const fam = familySelect?.value || '';
      const int = intensitySelect?.value || '';
      const occ = occasionSelect?.value || '';
      const sort = sortSelect?.value || '';

      if (fam) params.set('familia', fam);
      if (int) params.set('intensity', int);
      if (occ) params.set('occasion', occ);
      if (sort && sort !== 'featured') params.set('sort', sort);

      const query = params.toString();
      const newURL = query ? `${window.location.pathname}?${query}` : window.location.pathname;

      if (push) {
        window.history.pushState({}, '', newURL);
      } else {
        window.history.replaceState({}, '', newURL);
      }
    }

    function updateBreadcrumb() {
      if (!bcContainer) return;
      let html = '';

      if (activeCategory) {
        const catName = categoryLabels[activeCategory] || activeCategory;
        if (activeSubcategory) {
          const subName = subcategoryLabels[activeSubcategory] || activeSubcategory;
          html += ` <span class="breadcrumb-sep" aria-hidden="true">/</span> <a href="/perfumes?categoria=${activeCategory}">${catName}</a> <span class="breadcrumb-sep" aria-hidden="true">/</span> <span aria-current="page">${subName}</span>`;
        } else {
          html += ` <span class="breadcrumb-sep" aria-hidden="true">/</span> <span aria-current="page">${catName}</span>`;
        }
      } else if (activeSubcategory) {
        const subName = subcategoryLabels[activeSubcategory] || activeSubcategory;
        html += ` <span class="breadcrumb-sep" aria-hidden="true">/</span> <span aria-current="page">${subName}</span>`;
      } else if (familySelect && familySelect.value) {
        const famName = familyLabels[familySelect.value] || familySelect.value;
        html += ` <span class="breadcrumb-sep" aria-hidden="true">/</span> <span aria-current="page">Familia: ${famName}</span>`;
      }

      bcContainer.innerHTML = html;
    }

    function updateActivePills() {
      if (!activeFiltersBar || !activePillsList) return;
      const pills: { label: string; onRemove: () => void }[] = [];

      if (activeCategory) {
        pills.push({
          label: `Categoría: ${categoryLabels[activeCategory] || activeCategory}`,
          onRemove: () => {
            activeCategory = '';
            activeSubcategory = '';
            updateCategoryTabsUI();
            updateSubcategoryChipsUI();
            applyFilters(true);
          },
        });
      }

      if (activeSubcategory) {
        pills.push({
          label: `Subcategoría: ${subcategoryLabels[activeSubcategory] || activeSubcategory}`,
          onRemove: () => {
            activeSubcategory = '';
            updateSubcategoryChipsUI();
            applyFilters(true);
          },
        });
      }

      if (familySelect && familySelect.value) {
        const famVal = familySelect.value;
        pills.push({
          label: `Familia: ${familyLabels[famVal] || famVal}`,
          onRemove: () => {
            familySelect.value = '';
            applyFilters(true);
          },
        });
      }

      if (intensitySelect && intensitySelect.value) {
        pills.push({
          label: `Intensidad: ${intensitySelect.value}`,
          onRemove: () => {
            intensitySelect.value = '';
            applyFilters(true);
          },
        });
      }

      if (occasionSelect && occasionSelect.value) {
        const occVal = occasionSelect.value;
        pills.push({
          label: `Ocasión: ${occVal === 'dia' ? 'Día' : 'Noche'}`,
          onRemove: () => {
            occasionSelect.value = '';
            applyFilters(true);
          },
        });
      }

      if (pills.length > 0) {
        activeFiltersBar.style.display = 'flex';
        activePillsList.innerHTML = '';
        pills.forEach((p) => {
          const pill = document.createElement('span');
          pill.className = 'filter-pill';
          pill.innerHTML = `<span>${p.label}</span><button type="button" class="filter-pill-remove" aria-label="Eliminar filtro ${p.label}">×</button>`;
          pill.querySelector('button')?.addEventListener('click', p.onRemove);
          activePillsList.appendChild(pill);
        });
      } else {
        activeFiltersBar.style.display = 'none';
        activePillsList.innerHTML = '';
      }
    }

    function sortProducts() {
      if (!grid) return;
      const sortValue = sortSelect?.value || 'featured';

      const sorted = [...productItems].sort((a, b) => {
        if (sortValue === 'price-asc') {
          return Number(a.dataset.price || 0) - Number(b.dataset.price || 0);
        } else if (sortValue === 'price-desc') {
          return Number(b.dataset.price || 0) - Number(a.dataset.price || 0);
        } else if (sortValue === 'name-asc') {
          return (a.dataset.name || '').localeCompare(b.dataset.name || '');
        }
        // 'featured' / default original order by SKU
        return (a.dataset.sku || '').localeCompare(b.dataset.sku || '');
      });

      sorted.forEach((item) => grid.appendChild(item));
    }

    function applyFilters(pushHistory: boolean = false) {
      const selectedFamily = familySelect?.value.trim().toLowerCase() || '';
      const selectedIntensity = intensitySelect?.value.trim() || '';
      const selectedOccasion = occasionSelect?.value.trim().toLowerCase() || '';

      let visibleCount = 0;

      productItems.forEach((item) => {
        const itemCat = item.dataset.categoryId || '';
        const itemSubcat = item.dataset.subcategoryId || '';
        const itemFamilyIds = (item.dataset.familyIds || '').split(' ');
        const itemIntensity = item.dataset.intensity || '';
        const itemOccasion = normalizeText(item.dataset.occasion || '');
        const itemTags = normalizeText(item.dataset.tags || '');

        // 1. Category matching
        let matchesCategory = true;
        if (activeCategory) {
          matchesCategory = itemCat === activeCategory;
        }

        // 2. Subcategory matching
        let matchesSubcategory = true;
        if (activeSubcategory) {
          matchesSubcategory = itemSubcat === activeSubcategory;
        }

        // 3. Olfactory Family matching (Exact slug matching)
        let matchesFamily = true;
        if (selectedFamily) {
          matchesFamily = itemFamilyIds.includes(selectedFamily);
        }

        // 4. Intensity matching
        let matchesIntensity = true;
        if (selectedIntensity) {
          matchesIntensity = normalizeText(itemIntensity) === normalizeText(selectedIntensity);
        }

        // 5. Occasion matching
        let matchesOccasion = true;
        if (selectedOccasion) {
          if (selectedOccasion === 'dia') {
            matchesOccasion =
              itemOccasion.includes('dia') ||
              itemOccasion.includes('oficina') ||
              itemTags.includes('dia') ||
              itemTags.includes('primavera');
          } else if (selectedOccasion === 'noche') {
            matchesOccasion =
              itemOccasion.includes('noche') ||
              itemOccasion.includes('nocturn') ||
              itemTags.includes('noche');
          } else {
            matchesOccasion =
              itemOccasion.includes(selectedOccasion) || itemTags.includes(selectedOccasion);
          }
        }

        const isVisible =
          matchesCategory &&
          matchesSubcategory &&
          matchesFamily &&
          matchesIntensity &&
          matchesOccasion;

        if (isVisible) {
          item.classList.remove('is-hidden');
          item.removeAttribute('aria-hidden');
          visibleCount++;
        } else {
          item.classList.add('is-hidden');
          item.setAttribute('aria-hidden', 'true');
        }
      });

      // Update counter
      if (resultsCount) {
        if (visibleCount === totalCount) {
          resultsCount.textContent = `Mostrando ${totalCount} fragancias`;
        } else if (visibleCount === 1) {
          resultsCount.textContent = `Mostrando 1 de ${totalCount} fragancias`;
        } else {
          resultsCount.textContent = `Mostrando ${visibleCount} de ${totalCount} fragancias`;
        }
      }

      // Update empty state
      if (emptyState && grid) {
        if (visibleCount === 0) {
          emptyState.style.display = 'block';
          grid.style.display = 'none';
        } else {
          emptyState.style.display = 'none';
          grid.style.display = 'grid';
        }
      }

      // Clear button disabled state
      const hasActiveFilters = Boolean(
        activeCategory ||
          activeSubcategory ||
          selectedFamily ||
          selectedIntensity ||
          selectedOccasion
      );
      if (clearBtn) {
        clearBtn.disabled = !hasActiveFilters;
      }

      sortProducts();
      updateBreadcrumb();
      updateActivePills();
      updateURLAndHistory(pushHistory);
    }

    function clearAllFilters() {
      activeCategory = '';
      activeSubcategory = '';
      if (familySelect) familySelect.value = '';
      if (intensitySelect) intensitySelect.value = '';
      if (occasionSelect) occasionSelect.value = '';
      if (sortSelect) sortSelect.value = 'featured';
      updateCategoryTabsUI();
      updateSubcategoryChipsUI();
      applyFilters(true);
    }

    // Scroll helper for mobile viewports
    function maybeScrollToGrid() {
      if (window.innerWidth < 768 && grid) {
        const top = grid.getBoundingClientRect().top + window.scrollY - 100;
        window.scrollTo({ top, behavior: 'smooth' });
      }
    }

    // Category Tabs click listeners
    catTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const cat = tab.dataset.catTab || '';
        activeCategory = cat;
        if (activeSubcategory) {
          const validSub = subcatChips.find(
            (c) =>
              c.dataset.subcatChip === activeSubcategory &&
              (!cat || c.dataset.parentCat === cat)
          );
          if (!validSub) activeSubcategory = '';
        }
        updateCategoryTabsUI();
        updateSubcategoryChipsUI();
        applyFilters(true);
        maybeScrollToGrid();
      });
    });

    // Subcategory Chips click listeners
    subcatChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const sub = chip.dataset.subcatChip || '';
        const parent = chip.dataset.parentCat || '';
        activeSubcategory = sub;
        if (parent && parent !== 'all' && !activeCategory) {
          activeCategory = parent;
          updateCategoryTabsUI();
        }
        updateSubcategoryChipsUI();
        applyFilters(true);
        maybeScrollToGrid();
      });
    });

    // Select filters
    familySelect?.addEventListener('change', () => applyFilters(true));
    intensitySelect?.addEventListener('change', () => applyFilters(true));
    occasionSelect?.addEventListener('change', () => applyFilters(true));
    sortSelect?.addEventListener('change', () => applyFilters(true));

    clearBtn?.addEventListener('click', clearAllFilters);
    emptyClearBtn?.addEventListener('click', clearAllFilters);
    clearAllPillsBtn?.addEventListener('click', clearAllFilters);

    // Browser navigation back/forward support (popstate)
    window.addEventListener('popstate', () => {
      syncStateFromURL();
      applyFilters(false);
    });

    // Initial setup from URL
    syncStateFromURL();
    applyFilters(false);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCatalogHierarchy);
  } else {
    initCatalogHierarchy();
  }
</script>
