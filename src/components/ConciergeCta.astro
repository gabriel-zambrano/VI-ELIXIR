---
export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  primaryCtaText?: string;
  primaryCtaUrl?: string;
  secondaryCtaText?: string;
  secondaryCtaUrl?: string;
  variant?: 'home' | 'catalog';
}

const {
  eyebrow = 'Concierge Olfativo & Asesoramiento',
  title = 'Encontrá la <em>esencia</em> que hable por vos.',
  subtitle = 'Elegir una fragancia de autor es una experiencia sensorial íntima. Si querés conocer cómo evolucionan nuestros acordes en tu piel o buscás orientación personalizada, nuestro equipo te acompaña en cada detalle.',
  primaryCtaText = 'Explorar Colección Completa',
  primaryCtaUrl = '/perfumes',
  secondaryCtaText = 'Solicitar Asesoramiento Olfativo',
  secondaryCtaUrl = '/contacto?consulta=Asesoramiento+Olfativo',
  variant = 'home',
} = Astro.props;
---

<section class="concierge-cta-section" aria-labelledby="concierge-cta-title">
  <!-- Ambient backdrop with subtle desert glow -->
  <div class="concierge-backdrop" aria-hidden="true">
    <div class="concierge-ambient-glow"></div>
  </div>

  <div class="container container--narrow concierge-content reveal">
    <!-- Monogram / Watermark Icon -->
    <div class="concierge-crest" aria-hidden="true">
      <svg width="36" height="36" viewBox="0 0 40 40" fill="none" stroke="currentColor">
        <circle cx="20" cy="20" r="18" stroke-width="1" stroke-opacity="0.35" />
        <path d="M14 16L20 28L26 16" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
        <line x1="20" y1="12" x2="20" y2="15" stroke-width="1.2" stroke-linecap="round" />
      </svg>
    </div>

    <!-- Eyebrow & Main Headings -->
    <span class="text-label concierge-eyebrow">{eyebrow}</span>
    <h2 id="concierge-cta-title" class="concierge-title" set:html={title} />
    <p class="concierge-subtitle">{subtitle}</p>

    <!-- 3 Value Pillars -->
    <div class="concierge-pillars" role="list">
      <div class="pillar-item" role="listitem">
        <div class="pillar-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 2L15 8L21 9L17 14L18 20L12 17L6 20L7 14L3 9L9 8L12 2Z" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="pillar-text">
          <h3 class="pillar-title">Acordes de Autor</h3>
          <p class="pillar-desc">Oud, ámbar, azafrán y flores exóticas con alta concentración y fijación en piel.</p>
        </div>
      </div>

      <div class="pillar-item" role="listitem">
        <div class="pillar-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="4" width="18" height="16" rx="2" stroke-linejoin="round"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
            <line x1="10" y1="4" x2="10" y2="20"/>
          </svg>
        </div>
        <div class="pillar-text">
          <h3 class="pillar-title">Sets de Muestras</h3>
          <p class="pillar-desc">Explorá las 6 fragancias en formato de cata antes de adquirir tu frasco de 100ml.</p>
        </div>
      </div>

      <div class="pillar-item" role="listitem">
        <div class="pillar-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <div class="pillar-text">
          <h3 class="pillar-title">Guía Personalizada</h3>
          <p class="pillar-desc">Conversá con nuestro equipo para definir la estela y presencia adecuada para tu estilo.</p>
        </div>
      </div>
    </div>

    <!-- Dual Actions: Primary (Purchase/Catalog) & Secondary (Consultation) -->
    <div class="concierge-actions">
      <a href={primaryCtaUrl} class="btn btn--primary btn--lg concierge-btn-primary">
        <span>{primaryCtaText}</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <a href={secondaryCtaUrl} class="btn btn--outline btn--lg concierge-btn-secondary">
        <span>{secondaryCtaText}</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
      </a>
    </div>

    <!-- Trust Notes -->
    <div class="concierge-trust">
      <span class="trust-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        Eau de Parfum 100ml de autor
      </span>
      <span class="trust-sep">·</span>
      <span class="trust-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        Asesoría olfativa sin compromiso
      </span>
      <span class="trust-sep">·</span>
      <span class="trust-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        Entrega y embalaje de cortesía
      </span>
    </div>
  </div>
</section>

<style>
  .concierge-cta-section {
    position: relative;
    background-color: var(--color-carbon);
    color: var(--color-ivory);
    padding-block: var(--space-4xl);
    overflow: hidden;
    border-top: 1px solid rgba(184, 178, 168, 0.2);
    border-bottom: 1px solid rgba(184, 178, 168, 0.2);
  }

  /* Ambient backdrop */
  .concierge-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .concierge-ambient-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 10%, rgba(84, 43, 53, 0.45) 0%, transparent 60%),
      radial-gradient(circle at 85% 80%, rgba(184, 178, 168, 0.12) 0%, transparent 50%),
      url('/images/editorial/desert-ambient-bg.webp') center/cover no-repeat;
    opacity: 0.25;
    filter: blur(8px);
    transform: scale(1.05);
  }

  .concierge-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 860px;
  }

  .concierge-crest {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-stone);
    margin-bottom: var(--space-sm);
  }

  .concierge-eyebrow {
    display: block;
    color: var(--color-stone);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-widest);
    text-transform: uppercase;
    margin-bottom: var(--space-sm);
  }

  .concierge-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: var(--font-weight-light);
    line-height: var(--line-height-snug);
    color: var(--color-ivory);
    margin-bottom: var(--space-md);
    text-wrap: balance;
  }

  .concierge-title :global(em) {
    font-style: italic;
    color: #E8D5B5; /* Warm champagne accent */
    font-weight: var(--font-weight-light);
  }

  .concierge-subtitle {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    line-height: var(--line-height-normal);
    color: rgba(242, 238, 230, 0.85);
    max-width: 680px;
    margin-inline: auto;
    margin-bottom: var(--space-2xl);
    font-weight: var(--font-weight-light);
    text-wrap: pretty;
  }

  /* 3 Pillars */
  .concierge-pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    text-align: left;
    margin-bottom: var(--space-2xl);
    padding: var(--space-lg);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(184, 178, 168, 0.15);
    border-radius: var(--border-radius-md);
    backdrop-filter: blur(8px);
  }

  .pillar-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .pillar-icon {
    color: #E8D5B5;
    margin-bottom: var(--space-xs);
  }

  .pillar-title {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-ivory);
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  .pillar-desc {
    font-size: var(--font-size-xs);
    line-height: 1.5;
    color: var(--color-stone);
    margin: 0;
  }

  /* Action Buttons */
  .concierge-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }

  .concierge-btn-primary {
    background-color: var(--color-burgundy);
    border-color: var(--color-burgundy);
    color: var(--color-white);
    box-shadow: 0 4px 20px rgba(84, 43, 53, 0.45);
  }

  .concierge-btn-primary:hover {
    background-color: var(--color-burgundy-light);
    border-color: var(--color-burgundy-light);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(84, 43, 53, 0.6);
  }

  .concierge-btn-secondary {
    border-color: rgba(242, 238, 230, 0.4);
    color: var(--color-ivory);
    background-color: transparent;
  }

  .concierge-btn-secondary:hover {
    border-color: var(--color-ivory);
    background-color: rgba(242, 238, 230, 0.08);
    color: var(--color-white);
    transform: translateY(-2px);
  }

  /* Trust Badges */
  .concierge-trust {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    font-size: var(--font-size-xs);
    color: var(--color-stone);
  }

  .trust-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .trust-badge svg {
    color: #E8D5B5;
  }

  .trust-sep {
    opacity: 0.4;
  }

  @media (max-width: 820px) {
    .concierge-cta-section {
      padding-block: var(--space-3xl);
    }

    .concierge-pillars {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      text-align: left;
      padding: var(--space-md);
    }

    .concierge-actions {
      flex-direction: column;
      width: 100%;
    }

    .concierge-btn-primary,
    .concierge-btn-secondary {
      width: 100%;
    }

    .concierge-trust {
      flex-direction: column;
      gap: var(--space-xs);
    }

    .trust-sep {
      display: none;
    }
  }
</style>
