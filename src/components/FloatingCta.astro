---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const isContactPage = currentPath === '/contacto';
---

<div
  class="floating-cta-dock"
  id="floating-cta-dock"
  role="complementary"
  aria-label="Asesoramiento y compra de fragancias"
  data-floating-cta
>
  <div class="dock-inner">
    <!-- Close / Minimize button -->
    <button
      type="button"
      class="dock-close-btn"
      id="dock-close-btn"
      aria-label="Minimizar barra de asesoramiento"
      title="Minimizar"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Info side -->
    <div class="dock-info">
      <div class="dock-badge">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span class="dock-badge-label">Concierge VI-ELIXIR</span>
      </div>
      <p class="dock-title">
        {isContactPage
          ? 'Explorá nuestras 6 fragancias de autor en catálogo.'
          : '¿Dudas sobre notas, fijación o qué esencia elegir?'}
      </p>
    </div>

    <!-- Actions side -->
    <div class="dock-actions">
      {!currentPath.startsWith('/perfumes') ? (
        <a href="/perfumes" class="dock-btn dock-btn--primary">
          <span>Comprar / Ver catálogo</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      ) : (
        <a href="/#sets" class="dock-btn dock-btn--primary">
          <span>Ver Discovery Sets</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      )}

      {!isContactPage && (
        <a
          href="/contacto?consulta=Asesoramiento+Olfativo"
          class="dock-btn dock-btn--secondary"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <span>Asesoría directa</span>
        </a>
      )}
    </div>
  </div>
</div>

<!-- Collapsed launcher button (shown when dock is minimized) -->
<button
  type="button"
  class="floating-launcher"
  id="floating-launcher"
  aria-label="Abrir asistente y concierge olfativo"
  title="Abrir Concierge Olfativo"
  style="display: none;"
>
  <span class="launcher-pulse" aria-hidden="true"></span>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
  </svg>
  <span class="launcher-text">Concierge</span>
</button>

<style>
  /* --------------------------------------------------------------------------
     FLOATING DOCK CONTAINER
     -------------------------------------------------------------------------- */
  .floating-cta-dock {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translate3d(-50%, 120%, 0);
    z-index: 180;
    width: calc(100% - 190px);
    max-width: 680px;
    opacity: 0;
    pointer-events: none;
    transition:
      transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 300ms ease,
      visibility 400ms;
    visibility: hidden;
  }

  .floating-cta-dock.is-visible {
    transform: translate3d(-50%, 0, 0);
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .floating-cta-dock.is-hidden-by-footer {
    transform: translate3d(-50%, 130%, 0);
    opacity: 0;
    pointer-events: none;
  }

  /* Glassmorphism Luxury Styling */
  .dock-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    background: rgba(32, 32, 31, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(184, 178, 168, 0.28);
    border-radius: 999px;
    padding: 0.75rem 1.25rem 0.75rem 1.5rem;
    box-shadow:
      0 16px 40px rgba(0, 0, 0, 0.38),
      0 2px 10px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  /* Close button */
  .dock-close-btn {
    position: absolute;
    top: -8px;
    right: 12px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-carbon);
    border: 1px solid rgba(184, 178, 168, 0.3);
    color: var(--color-stone);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color var(--transition-fast), background-color var(--transition-fast), transform var(--transition-fast);
    padding: 0;
    z-index: 2;
  }

  .dock-close-btn:hover {
    color: var(--color-ivory);
    background: var(--color-burgundy);
    transform: scale(1.1);
  }

  /* Info / Copy */
  .dock-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .dock-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-widest);
    text-transform: uppercase;
    color: #E8D5B5;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #E8D5B5;
    box-shadow: 0 0 0 0 rgba(232, 213, 181, 0.7);
    animation: dockPulse 2.4s infinite;
  }

  @keyframes dockPulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(232, 213, 181, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px rgba(232, 213, 181, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(232, 213, 181, 0);
    }
  }

  .dock-title {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    color: var(--color-ivory);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Actions */
  .dock-actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-shrink: 0;
  }

  .dock-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0.55rem 1.15rem;
    font-size: 0.75rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--transition-base),
      color var(--transition-base),
      transform var(--transition-fast),
      box-shadow var(--transition-base);
  }

  .dock-btn:hover {
    text-decoration: none;
  }

  .dock-btn--primary {
    background-color: var(--color-burgundy);
    color: var(--color-white);
    border: 1px solid var(--color-burgundy);
  }

  .dock-btn--primary:hover {
    background-color: var(--color-burgundy-light);
    border-color: var(--color-burgundy-light);
    color: var(--color-white);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(84, 43, 53, 0.4);
  }

  .dock-btn--secondary {
    background-color: rgba(255, 255, 255, 0.06);
    color: var(--color-ivory);
    border: 1px solid rgba(184, 178, 168, 0.35);
  }

  .dock-btn--secondary:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: var(--color-ivory);
    color: var(--color-white);
    transform: translateY(-1px);
  }

  /* --------------------------------------------------------------------------
     COLLAPSED LAUNCHER (MINIMIZED STATE)
     -------------------------------------------------------------------------- */
  .floating-launcher {
    position: fixed;
    bottom: 24px;
    left: 24px;
    right: auto;
    z-index: 180;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    background: rgba(32, 32, 31, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(184, 178, 168, 0.3);
    color: var(--color-ivory);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    cursor: pointer;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    transition: transform var(--transition-fast), background-color var(--transition-base), box-shadow var(--transition-base);
  }

  .floating-launcher:hover {
    transform: translateY(-2px);
    background: var(--color-burgundy);
    border-color: var(--color-burgundy);
    box-shadow: 0 12px 28px rgba(84, 43, 53, 0.45);
  }

  .launcher-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #E8D5B5;
    animation: dockPulse 2s infinite;
  }

  /* --------------------------------------------------------------------------
     RESPONSIVE BREAKPOINTS
     -------------------------------------------------------------------------- */
  @media (max-width: 860px) {
    .floating-cta-dock {
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      width: calc(100% - 20px);
    }

    .dock-inner {
      flex-direction: column;
      align-items: stretch;
      border-radius: var(--border-radius-lg);
      padding: 0.85rem 1rem 0.95rem;
      gap: var(--space-sm);
    }

    .dock-close-btn {
      top: 8px;
      right: 8px;
    }

    .dock-title {
      font-size: 0.8125rem;
      white-space: normal;
      padding-right: 20px;
    }

    .dock-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xs);
      width: 100%;
    }

    .dock-btn {
      padding: 0.65rem 0.5rem;
      font-size: 0.6875rem;
      width: 100%;
      text-align: center;
      border-radius: var(--border-radius-sm);
    }

    .floating-launcher {
      bottom: calc(16px + env(safe-area-inset-bottom, 0px));
      left: 16px;
      right: auto;
      padding: 0.6rem 0.9rem;
    }
  }
</style>

<script>
  function setupFloatingCta() {
    const dock = document.getElementById('floating-cta-dock');
    const closeBtn = document.getElementById('dock-close-btn');
    const launcher = document.getElementById('floating-launcher');

    if (!dock) return;

    let isDismissed = sessionStorage.getItem('vi_floating_cta_dismissed') === 'true';

    // Show launcher if already dismissed
    if (isDismissed && launcher) {
      launcher.style.display = 'inline-flex';
    }

    // Scroll trigger: show after scrolling down 320px
    const handleScroll = () => {
      if (isDismissed) return;

      const scrollY = window.scrollY || window.pageYOffset;
      const shouldShow = scrollY > 320;

      if (shouldShow) {
        dock.classList.add('is-visible');
      } else {
        dock.classList.remove('is-visible');
      }

      // Check if user is near bottom footer or inside dedicated concierge section
      const footer = document.querySelector('.site-footer');
      const conciergeSection = document.querySelector('.concierge-cta-section');
      const checkElem = conciergeSection || footer;

      let isNearFooter = false;
      if (checkElem) {
        const rect = checkElem.getBoundingClientRect();
        if (rect.top <= window.innerHeight - 50) {
          isNearFooter = true;
        }
      }

      if (isNearFooter) {
        dock.classList.add('is-hidden-by-footer');
      } else {
        dock.classList.remove('is-hidden-by-footer');
      }

      const isActuallyVisible = shouldShow && !isNearFooter;
      document.body.classList.toggle('has-floating-cta-visible', isActuallyVisible);
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // Close / Minimize
    closeBtn?.addEventListener('click', () => {
      dock.classList.remove('is-visible');
      document.body.classList.remove('has-floating-cta-visible');
      isDismissed = true;
      sessionStorage.setItem('vi_floating_cta_dismissed', 'true');
      if (launcher) {
        launcher.style.display = 'inline-flex';
      }
    });

    // Reopen via launcher
    launcher?.addEventListener('click', () => {
      isDismissed = false;
      sessionStorage.removeItem('vi_floating_cta_dismissed');
      launcher.style.display = 'none';
      dock.classList.remove('is-hidden-by-footer');
      dock.classList.add('is-visible');
      document.body.classList.add('has-floating-cta-visible');
    });
  }

  // Run on load and after client navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFloatingCta);
  } else {
    setupFloatingCta();
  }
</script>
